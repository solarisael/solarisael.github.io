---
import { getCollection } from "astro:content";
import IndexLayout from "../layouts/index.astro";
import LinkList from "../components/page/link_list.astro";
import PageHero from "../components/page/hero.astro";
import PageSection from "../components/page/section.astro";
import { with_base } from "../utils/routes.js";

const category_labels = {
  characters: "Characters",
  factions: "Factions",
  places: "Places",
  relics: "Relics",
};

const codex_entries = await getCollection("codex", ({ data, id }) => {
  if (data?.draft) return false;
  const stem = String(id).split("/").pop()?.toLowerCase() ?? "";
  return stem !== "readme" && stem !== "_template";
});

const category_slugs = [
  ...new Set(
    codex_entries
      .map((entry) => String(entry.id).split("/"))
      .filter((segments) => segments.length > 1)
      .map(([category]) => category),
  ),
].sort((left, right) => left.localeCompare(right));

const categories = category_slugs.map((slug) => ({
  slug,
  label:
    category_labels[slug] ??
    slug
      .replace(/[-_]+/g, " ")
      .replace(/\b\w/g, (letter) => letter.toUpperCase()),
}));

const labs = [
  { slug: "labs/text-effects", label: "Text Effects Reference" },
  { slug: "labs/block-effects", label: "Block and Combat Effects" },
  { slug: "labs/pretext-shapes", label: "Pretext Shapes" },
  { slug: "labs/text-transitions", label: "Text Transitions" },
  { slug: "labs/shader-chalice", label: "Shader Chalice" },
  { slug: "labs/fx-diagnostics", label: "FX Diagnostics" },
  { slug: "labs/test-overlays", label: "Overlay Sandbox" },
];

const category_links = categories.map((category) => ({
  href: with_base(`/codex/${category.slug}`),
  label: category.label,
}));

const lab_links = labs.map((lab) => ({
  href: with_base(`/codex/${lab.slug}`),
  label: lab.label,
}));
---

<IndexLayout phase="codex" page_title="Codex">
  <codex data-shape="index_page">
    <PageHero title="Codex">
      <p>
        The lore index. Everything on this site that has a name, a category, or
        a definition lives here. Entries can be cross-referenced by any page —
        hover a reference to see the entry inline.
      </p>
    </PageHero>

    <PageSection title="Categories">
      <LinkList items={category_links} />
    </PageSection>

    <PageSection title="Labs">
      <LinkList items={lab_links} />
    </PageSection>
  </codex>
</IndexLayout>
