---
import { getCollection, render } from "astro:content";
import IndexLayout from "../../layouts/index.astro";
import NigredoPill from "../../components/nigredo/pill.astro";
import { build_crumbs, with_base } from "../../utils/routes.js";
import { redact_length } from "../../utils/nigredo_feed.js";
// nigredo_page.css moved to layout-level for htmx-nav availability

export async function getStaticPaths() {
  const entries = await getCollection("nigredo", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { entry_slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const primary_state = entry.data.states[0];

const display_title = entry.data.title
  ? entry.data.title
  : "■".repeat(redact_length(entry.data.slug));
---

<IndexLayout
  page_title={display_title}
  phase="nigredo"
  crumbs={build_crumbs([
    { label: "nigredo", href: with_base("/nigredo") },
    { label: display_title, href: null },
  ])}
>
  <nigredo data-shape="entry_detail" class="sol__nigredo_detail">
    <div class="sol__nigredo_detail_header">
      <h1 class="sol__nigredo_detail_title" data-redacted={!entry.data.title}>
        {display_title}
      </h1>
      <div class="sol__nigredo_detail_meta">
        <NigredoPill state={primary_state} />
        <time
          class="sol__nigredo_entry_date"
          datetime={entry.data.published_at}
        >
          {entry.data.published_at}
        </time>
      </div>
    </div>

    <div class="sol__nigredo_detail_body sol__chapter_content">
      <Content />
    </div>
  </nigredo>
</IndexLayout>

<style>
  .sol__nigredo_detail {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sol__nigredo_detail_header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--mono_ink, #171717) 24%, transparent);
  }

  .sol__nigredo_detail_meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .sol__nigredo_detail_title {
    font-size: var(--text_h1, 32px);
    font-family: var(--font_reading_heading);
    font-weight: 500;
    line-height: 1.2;
    color: var(--mono_ink, #171717);
    margin: 0;
  }

  .sol__nigredo_detail_title[data-redacted="true"] {
    letter-spacing: 0.08em;
    color: color-mix(
      in srgb,
      var(--mono_ink, #171717) 62%,
      var(--mono_paper, #f7f4ed)
    );
    font-family: monospace;
  }

  .sol__nigredo_detail_body {
    max-width: 62ch;
  }
</style>
