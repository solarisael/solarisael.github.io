---
import { getCollection, render } from "astro:content";
import IndexLayout from "../../layouts/index.astro";
import AlbedoPill from "../../components/albedo/pill.astro";
import { build_crumbs, with_base } from "../../utils/routes.js";

export async function getStaticPaths() {
  const entries = await getCollection("albedo", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { post_slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const primary_state = entry.data.states[0];
const display_title = entry.data.title ?? entry.data.slug;
---

<IndexLayout
  page_title={display_title}
  phase="albedo"
  crumbs={build_crumbs([
    { label: "albedo", href: with_base("/albedo") },
    { label: display_title, href: null },
  ])}
>
  <albedo data-shape="entry_detail" class="sol__albedo_detail">
    <div class="sol__albedo_detail_header">
      <h1 class="sol__albedo_detail_title" data-untitled={!entry.data.title}>
        {display_title}
      </h1>
      <div class="sol__albedo_detail_meta">
        <AlbedoPill state={primary_state} />
        <time class="sol__albedo_entry_date" datetime={entry.data.published_at}>
          {entry.data.published_at}
        </time>
      </div>
    </div>

    <div class="sol__albedo_detail_body sol__chapter_content">
      <Content />
    </div>
  </albedo>
</IndexLayout>

<style>
  .sol__albedo_detail {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sol__albedo_detail_header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--mono_ink, #171717) 24%, transparent);
  }

  .sol__albedo_detail_meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .sol__albedo_detail_title {
    font-size: var(--text_h1, 32px);
    font-family: var(--font_reading_heading);
    font-weight: 500;
    line-height: 1.2;
    color: var(--mono_ink, #171717);
    margin: 0;
  }

  .sol__albedo_detail_title[data-untitled="true"] {
    font-style: italic;
    color: color-mix(
      in srgb,
      var(--mono_ink, #171717) 62%,
      var(--mono_paper, #f7f4ed)
    );
  }

  .sol__albedo_detail_body {
    max-width: 62ch;
  }
</style>
