---
import IndexLayout from "../layouts/index.astro";
import PhaseCardGrid from "../components/home/phase_card_grid.astro";
import HomeGate from "../components/home/home_gate.astro";

const phase_cards = [
  {
    phase_name: "Nigredo",
    phase_slug: "nigredo",
    phase_blurb:
      "The putrefaction: pieces written in moments of despair and delusion, moments that I barely remember when the sun rises.",
  },
  {
    phase_name: "Albedo",
    phase_slug: "albedo",
    phase_blurb:
      "A clear lake: records and reflections from moments when the fog within settles, a rare moment of respite.",
  },
  {
    phase_name: "Citrinitas",
    phase_slug: "citrinitas",
    phase_blurb:
      "A golden shelf: artifacts and references collected over the years, the only criteria is… making me smile.",
  },
  {
    phase_name: "Rubedo",
    phase_slug: "rubedo",
    phase_blurb: "My becoming. Work I want to be proud of.",
  },
];
---

<IndexLayout page_title="Writing" phase="writing" banner_title="Writing">
  <HomeGate>
    <Fragment slot="intro">
      <p class="sol__home_intro_line">My amateur writing and practice.</p>
      <p class="sol__home_intro_line">
        Unhinged late night ramblings, moments of clarity and hope, collections
        of poems and excerpts that make me keep walking forward… and maybe, just
        maybe, things I can be proud of.
      </p>
      <p class="sol__home_intro_line">
        To open this drawer is to expose myself in ways that still make me
        terribly uncomfortable.
      </p>
      <p class="sol__home_intro_line">But… I still have to show it.</p>
      <p class="sol__home_intro_line">
        Nothing better than some exposure to get better, right?
      </p>
      <p class="sol__home_intro_line">
        So… please. If you have any critiques, do send me a message… you can
        find my contact in the <strong>About</strong> page.
      </p>
    </Fragment>

    <Fragment slot="heading">The Four Gates</Fragment>

    <PhaseCardGrid phase_cards={phase_cards} />
  </HomeGate>
</IndexLayout>
