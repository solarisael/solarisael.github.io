---
import IndexLayout from "../../layouts/index.astro";
import ContentLink from "../../components/page/content_link.astro";
import {
  rubedo_book_map,
  rubedo_book_slugs,
} from "../../data/rubedo/book_timeline_runtime.js";
import { with_base } from "../../utils/routes.js";

export const getStaticPaths = () => {
  return rubedo_book_slugs.map((book_slug) => {
    return { params: { book_slug } };
  });
};

const { book_slug } = Astro.params;

const book_entry = rubedo_book_map[book_slug] ?? null;
const display_title = book_entry?.title ?? `Rubedo — ${book_slug}`;

// Chapters arrive sorted + slug-stamped from the runtime — no re-sort/derive.
const first_chapter = book_entry?.chapters[0] ?? null;

const canonical_reader_href = first_chapter
  ? with_base(`/rubedo/${book_slug}/${first_chapter.chapter_slug}`)
  : with_base("/rubedo");

const timeline_href = with_base(`/rubedo/${book_slug}/timeline`);
const rubedo_index_href = with_base("/rubedo");
---

<IndexLayout phase="rubedo" page_title={display_title}>
  <rubedo data-shape="book_page">
    <div class="sol__book_header">
      <h1>{display_title}</h1>
    </div>

    {
      book_entry ? (
        <p>{book_entry.synopsis}</p>
      ) : (
        <p>
          Unknown book slug <code>{book_slug}</code>. Return to Rubedo index.
        </p>
      )
    }

    <p>
      <ContentLink href={rubedo_index_href}> Back to Rubedo index </ContentLink>
    </p>

    {
      book_entry && (
        <>
          <p>
            <ContentLink href={canonical_reader_href}>
              Begin reading {book_entry.title}
            </ContentLink>
          </p>
          <p>
            <ContentLink href={timeline_href}>
              Open constellation timeline
            </ContentLink>
          </p>
        </>
      )
    }
  </rubedo>
</IndexLayout>
