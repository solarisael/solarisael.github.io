---
import ChapterLayout from "../../../../layouts/chapter.astro";
import ContentLink from "../../../../components/page/content_link.astro";
import ChapterIntro from "../../../../components/rubedo/chapter_intro.astro";

import {
  rubedo_book_map,
  rubedo_book_slugs,
} from "../../../../data/rubedo/book_timeline_runtime.js";
import {
  build_crumbs,
  content_link_attrs,
  with_base,
} from "../../../../utils/routes.js";

const default_thread_key = "cinza";
const default_thread_modifier = "core";

export const getStaticPaths = () => {
  return rubedo_book_slugs.flatMap((book_slug) => {
    const book_entry = rubedo_book_map[book_slug] ?? null;

    if (!book_entry) return [];

    return (book_entry.chapters ?? []).flatMap((chapter) => {
      const chapter_slug = chapter.chapter_slug;

      const thread_keys = [
        ...new Set(
          (chapter.scenes ?? [])
            .map((scene) => scene.thread_key)
            .filter(Boolean),
        ),
      ];

      return thread_keys.map((thread_key) => {
        return {
          params: { book_slug, thread_key, chapter_slug },
          props: { chapter, book_entry },
        };
      });
    });
  });
};

const { chapter, book_entry } = Astro.props;
const { book_slug, thread_key, chapter_slug } = Astro.params;

// Resolve the scene for the active thread — prefer core modifier.
const thread_scene =
  (chapter?.scenes ?? []).find((scene) => {
    return (
      scene.thread_key === thread_key &&
      scene.thread_modifier === default_thread_modifier
    );
  }) ??
  (chapter?.scenes ?? []).find((scene) => scene.thread_key === thread_key) ??
  null;

// Chapters arrive pre-sorted by timeline_position from the runtime.
const book_chapters = book_entry?.chapters ?? [];

const chapter_index = book_chapters.findIndex(
  (candidate) => candidate.chapter_id === chapter?.chapter_id,
);

const previous_chapter =
  chapter_index > 0 ? book_chapters[chapter_index - 1] : null;
const next_chapter =
  chapter_index >= 0 && chapter_index < book_chapters.length - 1
    ? book_chapters[chapter_index + 1]
    : null;

// Pager links preserve the active thread across chapters.
const build_chapter_href = (target_chapter) => {
  if (!target_chapter) return null;
  return with_base(
    `/rubedo/${book_slug}/${thread_key}/${target_chapter.chapter_slug}`,
  );
};

const build_hx_link = (href) => {
  if (!href) return null;
  return content_link_attrs(href);
};

const previous_chapter_link = build_hx_link(
  build_chapter_href(previous_chapter),
);
const next_chapter_link = build_hx_link(build_chapter_href(next_chapter));

const timeline_href = with_base(`/rubedo/${book_slug}/timeline`);

const ResolvedSceneComponent = thread_scene?.scene_component ?? null;

// Explicit breadcrumb trail — avoids exposing thread_key as a navigation segment.
// Cinza gets no thread suffix (canonical default). All others get " - thread_name".
const chapter_title = chapter?.title ?? chapter_slug;
const thread_suffix =
  thread_key !== default_thread_key ? ` - ${thread_key}` : "";
const page_title = `${chapter_title}${thread_suffix}`;

const crumbs = build_crumbs([
  { label: "rubedo", href: with_base("/rubedo") },
  {
    label: book_entry?.title ?? book_slug,
    href: with_base(`/rubedo/${book_slug}`),
  },
  {
    label: page_title,
    href: with_base(`/rubedo/${book_slug}/${thread_key}/${chapter_slug}`),
  },
]);
---

<ChapterLayout
  page_title={page_title}
  previous_chapter_link={previous_chapter_link}
  next_chapter_link={next_chapter_link}
  crumbs={crumbs}
>
  <ChapterIntro chapter={chapter} />

  <div id="sol_chapter_thread_content" data-thread-key={thread_key}>
    {
      ResolvedSceneComponent ? (
        <ResolvedSceneComponent />
      ) : thread_scene?.scene_lines?.length ? (
        thread_scene.scene_lines.map((scene_line) => <p>{scene_line}</p>)
      ) : (
        <p class="sol__thread_scene_empty">
          No scene found for thread <code>{thread_key}</code>.
        </p>
      )
    }
  </div>

  <p>
    <ContentLink href={timeline_href}>
      Back to {book_entry?.title ?? book_slug} constellation
    </ContentLink>
  </p>
</ChapterLayout>
