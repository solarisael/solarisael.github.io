---
import IndexLayout from "../layouts/index.astro";
import PageHero from "../components/page/hero.astro";
import PageSection from "../components/page/section.astro";
import BookList from "../components/rubedo/book_list.astro";
import {
  rubedo_book_map,
  rubedo_book_slugs,
} from "../data/rubedo/book_timeline_runtime.js";
import { with_base } from "../utils/routes.js";

// Book assembly owns sorting, titles, and chapter slugs.
const book_links = rubedo_book_slugs.map((book_slug) => {
  const book_entry = rubedo_book_map[book_slug];
  const chapters = book_entry.chapters;
  const first_chapter = chapters[0];

  return {
    book_slug,
    book_title: book_entry.title,
    synopsis: book_entry.synopsis,
    chapter_count: chapters.length,
    book_href: with_base(`/rubedo/${book_slug}`),
    reader_href: first_chapter
      ? with_base(`/rubedo/${book_slug}/${first_chapter.chapter_slug}`)
      : null,
    timeline_href: with_base(`/rubedo/${book_slug}/timeline`),
  };
});
---

<IndexLayout phase="rubedo" page_title="Rubedo">
  <rubedo data-shape="index_page">
    <PageHero title="Rubedo">
      <p>
        Finished work. Writing I am willing to put my name on, projects I
        consider my main goals. This is the seal.
      </p>
    </PageHero>

    <PageSection title="Works">
      <BookList books={book_links} />
    </PageSection>
  </rubedo>
</IndexLayout>
