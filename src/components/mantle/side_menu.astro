---
import "../../styles/components/side_menu.css";
import "../../styles/components/portal_enchantment.css";
import {
  SITE_NAV_ITEMS,
  WRITING_PHASE_NAV_ITEMS,
} from "../../data/site_nav.js";
import RitualSeparator from "../ornament/ritual_separator.astro";
import ObsidianTablet from "../ornament/obsidian_tablet.astro";
import { with_base } from "../../utils/routes.js";
import { site_fps_options } from "../../../public/js/modules/menu/preferences.js";
import {
  effect_categories,
  effect_presets,
} from "../../../public/js/modules/menu/effect_preferences.js";
const menu_items = [
  ...SITE_NAV_ITEMS,
  ...WRITING_PHASE_NAV_ITEMS.filter((item) => item.phase === "codex"),
];

const setting_depth = {
  "data-depth-region": true,
  "data-depth": 96,
  "data-depth-padding": 48,
  "data-depth-inner": 0.5,
};

const site_theme_options = [
  {
    label: "solarisael",
    value: "solarisael",
  },
];

const site_scale_options = [
  {
    label: "100%",
    value: "100",
  },
  {
    label: "90%",
    value: "90",
  },
  {
    label: "80%",
    value: "80",
  },
];

const user_text_options = [
  {
    label: "compact",
    value: "compact",
  },
  {
    label: "normal",
    value: "normal",
  },
  {
    label: "large",
    value: "large",
  },
];

const user_measure_options = [
  {
    label: "focused",
    value: "focused",
  },
  {
    label: "comfort",
    value: "comfort",
  },
  {
    label: "wide",
    value: "wide",
  },
];
---

<mantle
  data-shape="side_menu"
  id="sol_side_menu"
  data-side-menu-open="false"
  data-side-menu-view="root"
>
  <button
    id="sol_side_menu_trigger"
    type="button"
    data-side-menu-trigger
    aria-controls="sol_side_menu_panel"
    aria-expanded="false"
    aria-label="Open Solarisael menu"
  >
    <span class="sol__side_menu_sun" aria-hidden="true"></span>
    <span class="sol__side_menu_trigger_label">menu</span>
  </button>

  <dialog
    id="sol_side_menu_panel"
    role="dialog"
    aria-label="Site navigation"
    aria-modal="true"
    data-side-menu-panel-shell
  >
    <canvas data-portal-ink aria-hidden="true"></canvas>

    <ObsidianTablet>
      <canvas slot="scene" data-portal-moths aria-hidden="true"></canvas>
      <canvas slot="foreground" data-portal-lettering aria-hidden="true"
      ></canvas>
      <div id="sol_side_menu_panel_scroll">
        <div id="sol_side_menu_panel_header">
          <button
            type="button"
            data-side-menu-close
            data-depth-region
            data-depth="12"
            data-depth-padding="48"
            data-depth-inner="0.25"
            aria-label="Close Solarisael menu"
          >
            <svg
              class="sol__close_rim"
              viewBox="0 0 44 44"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <circle
                cx="22"
                cy="22"
                r="21.5"
                fill="#0d111870"
                vector-effect="non-scaling-stroke"
                stroke="currentColor"
                stroke-width="0.5"></circle>
            </svg>
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="m6 6 12 12M18 6 6 18"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path>
            </svg>
          </button>
        </div>

        <div id="sol_side_menu_viewport">
          <section
            class="sol__side_menu_view"
            data-side-menu-view-page="root"
            data-view-position="active"
            aria-hidden="false"
          >
            <h2 class="sr-only">Site navigation</h2>
            <nav id="sol_side_menu_routes" aria-label="Site navigation">
              <ul class="sol__side_menu_route_list">
                {
                  menu_items.map((nav_item) => (
                    <li>
                      <a
                        class="sol__side_menu_route"
                        data-side-menu-route
                        data-nav-label={nav_item.label}
                        data-phase={nav_item.phase}
                        href={with_base(nav_item.href)}
                        hx-get={with_base(nav_item.href)}
                      >
                        <span
                          data-inscription-text
                          data-depth-region
                          data-depth="192"
                          data-depth-padding="48"
                        >
                          {nav_item.label}
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>

              <RitualSeparator />
            </nav>

            <div class="sol__side_menu_touch_status">
              <p
                id="sol_portal_touch_hint"
                data-portal-touch-hint
                role="status"
                aria-live="polite"
                hidden
              >
                tap again to enter
              </p>
            </div>

            <div class="sol__side_menu_tools">
              <button
                class="sol__side_menu_icon"
                type="button"
                data-obsidian-button
                data-depth-region
                data-depth="60"
                data-depth-padding="48"
                data-depth-inner="0.5"
                data-side-menu-view-target="settings"
                data-side-menu-view-focus
                aria-controls="sol_side_menu_view_settings"
                aria-label="Site configuration"
              >
                <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                  <path
                    d="M13.52 7.35 13.71 4.22 18.29 4.22 18.48 7.35 22.25 9.53 25.06 8.13 27.35 12.09 24.73 13.82 24.73 18.18 27.35 19.91 25.06 23.87 22.25 22.47 18.48 24.65 18.29 27.78 13.71 27.78 13.52 24.65 9.75 22.47 6.94 23.87 4.65 19.91 7.27 18.18 7.27 13.82 4.65 12.09 6.94 8.13 9.75 9.53Z"
                  ></path>
                  <circle cx="16" cy="16" r="4"></circle>
                </svg>
                <span class="sol__side_menu_icon_label" aria-hidden="true">
                  Site configuration
                </span>
              </button>
              <button
                class="sol__side_menu_icon"
                type="button"
                data-site-scheme-toggle
                data-obsidian-button
                data-depth-region
                data-depth="60"
                data-depth-padding="48"
                data-depth-inner="0.5"
                aria-label="Use dark colour scheme"
                title="Use dark colour scheme"
              >
                <svg
                  class="sol__side_menu_scheme_icon"
                  viewBox="0 0 32 32"
                  aria-hidden="true"
                  focusable="false"
                >
                  <g class="sol__scheme_sun">
                    <circle cx="16" cy="16" r="6"></circle>
                    <path
                      d="M16 3v3m0 20v3M3 16h3m20 0h3M6.8 6.8l2.1 2.1m14.2 14.2 2.1 2.1M25.2 6.8l-2.1 2.1M8.9 23.1l-2.1 2.1"
                    ></path>
                  </g>
                  <path
                    class="sol__scheme_moon"
                    d="M25 19.4A10 10 0 0 1 12.6 7a10 10 0 1 0 12.4 12.4Z"
                  ></path>
                </svg>
                <span class="sol__side_menu_icon_label" aria-hidden="true"
                  >Appearance</span
                >
              </button>
              <button
                class="sol__side_menu_icon"
                type="button"
                data-side-menu-view-target="profile"
                data-obsidian-button
                data-depth-region
                data-depth="60"
                data-depth-padding="48"
                data-depth-inner="0.5"
                data-side-menu-view-focus
                aria-controls="sol_side_menu_view_profile"
                aria-label="Your profile"
              >
                <svg
                  class="sol__side_menu_hood"
                  viewBox="0 0 32 32"
                  aria-hidden="true"
                  focusable="false"
                >
                  <defs>
                    <linearGradient
                      id="sol_profile_hood_fill"
                      x1="0"
                      y1="0"
                      x2="1"
                      y2="1"
                    >
                      <stop offset="0" stop-color="#e0c58c"></stop>
                      <stop offset="0.45" stop-color="#8b7650"></stop>
                      <stop offset="1" stop-color="#302a25"></stop>
                    </linearGradient>
                  </defs>
                  <path
                    d="M16 2.5C10.5 6.5 8 12 8 17L3.5 26.5Q16 30.5 28.5 26.5L24 17C24 12 21.5 6.5 16 2.5Z"
                    fill="url(#sol_profile_hood_fill)"></path>
                  <path
                    d="M16 8.5C12 11 10.8 15 12.5 19L16 22.5 19.5 19C21.2 15 20 11 16 8.5Z"
                    fill="#020305"></path>
                  <path d="m12.5 19-4 8m11-8 4 8M16 22.5v5"></path>
                </svg>
                <span class="sol__side_menu_icon_label" aria-hidden="true">
                  Your profile
                </span>
              </button>
            </div>
          </section>

          <section
            id="sol_side_menu_view_settings"
            class="sol__side_menu_view sol__side_menu_settings_view"
            data-side-menu-view-page="settings"
            data-view-position="after"
            aria-labelledby="sol_side_menu_settings_title"
            aria-hidden="true"
            inert
          >
            <div class="sol__side_menu_view_header" {...setting_depth}>
              <button
                class="sol__side_menu_back"
                type="button"
                data-side-menu-view-target="root"
                data-side-menu-view-focus
                aria-controls="sol_side_menu_routes"
              >
                <span aria-hidden="true">‹</span>
                back
              </button>
              <div>
                <p class="sol__text_kicker">inner chamber</p>
                <h2 id="sol_side_menu_settings_title">Site configuration</h2>
              </div>
            </div>

            <p class="sol__side_menu_note">
              Tune the shell without moving the page out from under your eyes.
            </p>

            <RitualSeparator />

            <div class="sol__side_menu_settings_section">
              <h3>Appearance</h3>
              <label
                class="sol__side_menu_group"
                for="sol_side_menu_theme"
                {...setting_depth}
              >
                <span class="sol__side_menu_label sol__text_caption">theme</span
                >
                <select id="sol_side_menu_theme" data-site-theme-control>
                  {
                    site_theme_options.map((theme_option) => (
                      <option value={theme_option.value}>
                        {theme_option.label}
                      </option>
                    ))
                  }
                </select>
              </label>

              <label
                class="sol__side_menu_group"
                for="sol_side_menu_display"
                {...setting_depth}
              >
                <span class="sol__side_menu_label sol__text_caption"
                  >display tuning</span
                >
                <select
                  id="sol_side_menu_display"
                  data-site-display-control
                  aria-describedby="sol_side_menu_display_note"
                >
                  <option value="sdr">SDR</option>
                  <option value="hdr">HDR display</option>
                </select>
              </label>
              <p id="sol_side_menu_display_note" class="sol__side_menu_note">
                SDR is the default. The HDR profile keeps the original darker
                appearance. These profiles do not enable HDR output or change
                your display settings.
              </p>

              <label
                class="sol__side_menu_group"
                for="sol_side_menu_fps"
                {...setting_depth}
              >
                <span class="sol__side_menu_label sol__text_caption"
                  >menu animation limit</span
                >
                <select id="sol_side_menu_fps" data-site-fps-control>
                  {
                    site_fps_options.map((value) => (
                      <option value={value}>
                        {value === "display"
                          ? "Display refresh"
                          : `${value} FPS`}
                      </option>
                    ))
                  }
                </select>
              </label>

              <button
                type="button"
                class="sol__side_menu_group"
                data-side-menu-view-target="effects"
                data-side-menu-view-focus
                aria-controls="sol_side_menu_view_effects"
                {...setting_depth}
              >
                <span class="sol__side_menu_label sol__text_caption">
                  effects
                </span>
                <span aria-hidden="true">open</span>
              </button>

              <label
                class="sol__side_menu_group"
                for="sol_side_menu_scale"
                {...setting_depth}
              >
                <span class="sol__side_menu_label sol__text_caption">scale</span
                >
                <select id="sol_side_menu_scale" data-site-scale-control>
                  {
                    site_scale_options.map((scale_option) => (
                      <option value={scale_option.value}>
                        {scale_option.label}
                      </option>
                    ))
                  }
                </select>
              </label>

              <button
                type="button"
                class="sol__side_menu_reset"
                data-side-menu-reset="site"
                {...setting_depth}
              >
                reset site configuration
              </button>
            </div>
          </section>
          <section
            id="sol_side_menu_view_effects"
            class="sol__side_menu_view sol__side_menu_settings_view"
            data-side-menu-view-page="effects"
            data-side-menu-parent="settings"
            data-view-position="after"
            aria-labelledby="sol_side_menu_effects_title"
            aria-hidden="true"
            inert
          >
            <div class="sol__side_menu_view_header" {...setting_depth}>
              <button
                class="sol__side_menu_back"
                type="button"
                data-side-menu-view-target="settings"
                data-side-menu-view-focus
                aria-controls="sol_side_menu_view_settings"
              >
                <span aria-hidden="true">‹</span>
                back
              </button>
              <div>
                <p class="sol__text_kicker">inner chamber</p>
                <h2 id="sol_side_menu_effects_title">Effects</h2>
              </div>
            </div>

            <RitualSeparator />

            <div class="sol__side_menu_settings_section">
              <label
                class="sol__side_menu_group"
                for="sol_side_menu_effect_preset_all"
                {...setting_depth}
              >
                <span class="sol__side_menu_label sol__text_caption"
                  >overall theme</span
                >
                <select
                  id="sol_side_menu_effect_preset_all"
                  data-effect-preset="all"
                >
                  {
                    Object.keys(effect_presets).map((value) => (
                      <option value={value}>{value}</option>
                    ))
                  }
                  <option value="custom" disabled>custom</option>
                </select>
              </label>

              {
                effect_categories.map((category) => (
                  <div class="sol__side_menu_effect_category">
                    <h3>{category.label}</h3>
                    <label
                      class="sol__side_menu_group"
                      for={`sol_side_menu_effect_preset_${category.id}`}
                      {...setting_depth}
                    >
                      <span class="sol__side_menu_label sol__text_caption">
                        preset
                      </span>
                      <select
                        id={`sol_side_menu_effect_preset_${category.id}`}
                        data-effect-preset={category.id}
                        aria-label={`${category.label} preset`}
                      >
                        {Object.keys(effect_presets).map((value) => (
                          <option value={value}>{value}</option>
                        ))}
                        <option value="custom" disabled>
                          custom
                        </option>
                      </select>
                    </label>
                    {category.sliders.map((slider) => {
                      const input_id = `sol_side_menu_effect_${slider.key}`;
                      return (
                        <div
                          class="sol__side_menu_effect_slider"
                          {...setting_depth}
                        >
                          <label class="sol__side_menu_label" for={input_id}>
                            {slider.label}
                          </label>
                          <input
                            id={input_id}
                            type="range"
                            data-effect-slider={slider.key}
                            min={slider.min}
                            max={slider.max}
                            step={slider.step}
                            value={slider.defaultValue}
                          />
                          <output data-effect-value={slider.key} for={input_id}>
                            {slider.defaultValue}%
                          </output>
                        </div>
                      );
                    })}
                  </div>
                ))
              }

              <button
                type="button"
                class="sol__side_menu_reset"
                data-effect-reset
                {...setting_depth}
              >
                Reset effects
              </button>
            </div>
          </section>

          <section
            id="sol_side_menu_view_profile"
            class="sol__side_menu_view"
            data-side-menu-view-page="profile"
            data-view-position="after"
            aria-labelledby="sol_side_menu_profile_title"
            aria-hidden="true"
            inert
          >
            <div class="sol__side_menu_view_header">
              <button
                class="sol__side_menu_back"
                type="button"
                data-side-menu-view-target="root"
                data-side-menu-view-focus
                aria-controls="sol_side_menu_routes"
              >
                <span aria-hidden="true">‹</span>
                back
              </button>
              <div>
                <p class="sol__text_kicker">the visitor</p>
                <h2 id="sol_side_menu_profile_title">Your profile</h2>
              </div>
            </div>

            <RitualSeparator />

            <div class="sol__side_menu_settings_section">
              <h3>Reading</h3>
              <p class="sol__side_menu_note">
                Preferences that follow the reader, not the page.
              </p>

              <label class="sol__side_menu_group" for="sol_side_menu_text">
                <span class="sol__side_menu_label sol__text_caption">text</span>
                <select id="sol_side_menu_text" data-user-text-control>
                  {
                    user_text_options.map((text_option) => (
                      <option value={text_option.value}>
                        {text_option.label}
                      </option>
                    ))
                  }
                </select>
              </label>

              <label class="sol__side_menu_group" for="sol_side_menu_measure">
                <span class="sol__side_menu_label sol__text_caption"
                  >measure</span
                >
                <select id="sol_side_menu_measure" data-user-measure-control>
                  {
                    user_measure_options.map((measure_option) => (
                      <option value={measure_option.value}>
                        {measure_option.label}
                      </option>
                    ))
                  }
                </select>
              </label>
            </div>

            <RitualSeparator />

            <div class="sol__side_menu_settings_section">
              <h3>Local profile</h3>
              <p class="sol__side_menu_note">
                Your profile and preferences stay in this browser.
              </p>

              <dl class="sol__side_menu_status_list">
                <div>
                  <dt>profile</dt>
                  <dd>local visitor</dd>
                </div>
                <div>
                  <dt>storage</dt>
                  <dd>browser cookies</dd>
                </div>
              </dl>

              <button
                type="button"
                class="sol__side_menu_reset"
                data-side-menu-reset="user"
              >
                reset reading preferences
              </button>
            </div>
          </section>
        </div>
      </div>
    </ObsidianTablet>
  </dialog>
</mantle>
