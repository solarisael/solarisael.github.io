---
import { resolve_footer_sentences } from "../../data/footer_sentences.js";

// Default footer for the layout's "footer" slot.
// Per-page override available via <Fragment slot="footer">...</Fragment>.
const { footer_group = "nigredo" } = Astro.props;
const footer_rows = resolve_footer_sentences(footer_group);
const footer_row = footer_rows[0];
const has_content = Boolean(footer_row?.html?.trim());
---

<footer
  id="sol_footer"
  data-footer-group={footer_group}
  data-state={has_content ? "filled" : "empty"}
>
  {
    has_content && (
      <>
        {footer_rows.length > 1 && (
          <button
            type="button"
            class="sol__footer_step"
            data-footer-cycle-step="prev"
            aria-label="Previous message"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
        )}
        <span
          data-footer-cycle
          data-sol-pretext="justify"
          data-cycle-align={footer_row.align}
          set:html={footer_row.html}
        />
        {footer_rows.length > 1 && (
          <button
            type="button"
            class="sol__footer_step"
            data-footer-cycle-step="next"
            aria-label="Next message"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m9 6 6 6-6 6" />
            </svg>
          </button>
        )}
        {footer_rows.length > 1 && (
          <span
            class="sol__footer_counter"
            data-footer-cycle-counter
            aria-live="polite"
            aria-atomic="true"
          >
            {`1 / ${footer_rows.length}`}
          </span>
        )}
      </>
    )
  }
</footer>
