---
const has_heading = Astro.slots.has("heading");
---

<section id="sol_home_card_gate">
  <div id="sol_home_gate_body" class="sol__page_intro_typography">
    <slot name="intro" />
  </div>

  {
    has_heading && (
      <h2 id="sol_phase_card_heading">
        <slot name="heading" />
      </h2>
    )
  }

  <slot />
</section>
