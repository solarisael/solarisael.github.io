---
import { with_base } from "../../utils/routes.js";
import MantleFrame from "../mantle/mantle_frame.astro";

const { phase_cards = [] } = Astro.props;
---

<mantle data-shape="phase_grid" id="sol_phase_card_grid">
  {
    phase_cards.map((phase_card) => {
      const card_body = (
        <div class="sol__phase_card_layer_body">
          <h2 class="sol__phase_card_title sol__text_mid">
            {phase_card.phase_name}
          </h2>
          <p class="sol__phase_card_blurb sol__text_body">
            {phase_card.phase_blurb}
          </p>
        </div>
      );

      const class_name = `sol__phase_card_link sol__phase_card_${phase_card.visual_phase_slug ?? phase_card.phase_slug}`;

      const card = phase_card.disabled ? (
        <article
          class={`${class_name} sol__phase_card_disabled`}
          aria-disabled="true"
        >
          {card_body}
        </article>
      ) : (
        <a
          class={class_name}
          href={with_base(phase_card.phase_slug)}
          hx-get={with_base(phase_card.phase_slug)}
        >
          {card_body}
        </a>
      );

      return <MantleFrame variant="phase-card">{card}</MantleFrame>;
    })
  }
</mantle>
