---
/**
 * AlbedoList — virtual feed shell (parallel to NigredoList).
 * Astro emits one inert template per entry plus precomputed size/data payloads;
 * the client only windows, filters, and expands. Same machinery as nigredo,
 * washed register: no redaction, light/water container tints.
 */

import EntryRow from "./entry_row.astro";
import { ALBEDO_CONTAINERS } from "../../data/albedo_taxonomy.js";
import { serialize_json_for_script } from "../../utils/json_script.js";

const { archive_index = [] } = Astro.props;
const INITIAL_ENTRY_COUNT = 5;

const virtual_entries = archive_index.map(({ Content, ...entry }, index) => ({
  ...entry,
  index,
  key: `${entry.slug}:${index}`,
}));
const initial_entries = archive_index.slice(0, INITIAL_ENTRY_COUNT);
---

<albedo data-shape="list" class="sol__albedo_archive" data-albedo-archive>
  <!-- Filter block: calm grouped state field -->
  <div
    class="sol__albedo_filter_block"
    data-albedo-filter-rail
    data-archive-filter-rail
    data-mobile-collapsed="true"
  >
    <!-- Header row: label + clear -->
    <div class="sol__albedo_filter_header">
      <span class="sol__albedo_filter_title">states</span>
      <button
        class="sol__archive_filter_toggle"
        data-albedo-filter-toggle
        data-archive-filter-toggle
        type="button"
        aria-controls="sol_albedo_filter_field"
        aria-expanded="false"
      >
        show filters
      </button>
      <button
        class="sol__albedo_filter_clear sol__text_kicker"
        data-albedo-filter-clear
        type="button"
        hidden>clear</button
      >
    </div>

    <!-- Inner field: states grouped into light/water containers. -->
    <div
      id="sol_albedo_filter_field"
      class="sol__albedo_filter_field"
      data-archive-filter-field
    >
      <div class="sol__albedo_filter_groups">
        {
          ALBEDO_CONTAINERS.map((container) => (
            <div
              class="sol__albedo_filter_group"
              data-container={container.key}
            >
              <button
                class="sol__albedo_filter_group_label"
                data-filter-container={container.key}
                data-active="false"
                type="button"
                aria-pressed="false"
                aria-label={`toggle ${container.label} states`}
              >
                {container.label}
              </button>
              <div class="sol__albedo_filter_pills">
                {container.states.map((state) => (
                  <button
                    class="sol__albedo_filter_btn sol__albedo_pill"
                    data-filter-state={state}
                    data-container={container.key}
                    data-active="false"
                    type="button"
                    aria-pressed="false"
                  >
                    {state}
                  </button>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Status row -->
  <div
    class="sol__albedo_archive_status"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    <span class="sol__albedo_archive_count sol__text_kicker" data-albedo-count>
      {archive_index.length}
    </span>
    <span class="sol__albedo_archive_count_label sol__text_kicker">notes</span>
    <span
      class="sol__albedo_archive_filter_summary sol__text_kicker"
      data-albedo-filter-summary
      hidden></span>
  </div>

  <!-- Feed pane: window-scrolled virtual track. -->
  <div class="sol__albedo_scroll_pane" data-albedo-scroll>
    <div class="sol__albedo_inner_track" data-albedo-inner>
      <ol
        class="sol__albedo_list"
        data-albedo-list
        aria-label="Albedo archive entries"
      >
        {
          initial_entries.map((entry, index) => (
            <EntryRow
              entry={entry}
              index={index}
              set_size={archive_index.length}
              prerendered
            />
          ))
        }
      </ol>
    </div>
  </div>
</albedo>

<script
  id="sol_albedo_archive_index"
  type="application/json"
  set:html={serialize_json_for_script(virtual_entries)}
/>

{
  archive_index.map((entry, index) => (
    <template data-albedo-entry-template data-index={index}>
      <EntryRow entry={entry} index={index} set_size={archive_index.length} />
    </template>
  ))
}

<noscript>
  <ol
    class="sol__albedo_list sol__albedo_list_fallback"
    aria-label="Albedo archive entries"
  >
    {
      archive_index.slice(0, 12).map((entry, index) => (
        <li aria-posinset={index + 1} aria-setsize={archive_index.length}>
          <a href={entry.href}>{entry.display_title}</a>
        </li>
      ))
    }
  </ol>
</noscript>

<script>
  import { init_albedo_archive } from "../../scripts/albedo_archive.js";
  init_albedo_archive();
</script>
