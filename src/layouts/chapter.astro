---
import IndexLayout from "./index.astro";

const {
  page_title = null,
  phase = "rubedo",
  previous_chapter_link = null,
  next_chapter_link = null,
  crumb_label_overrides = {},
  crumbs = null,
} = Astro.props;
---

<IndexLayout
  page_title={page_title}
  phase={phase}
  crumbs={crumbs}
  crumb_label_overrides={crumb_label_overrides}
>
  <rubedo data-shape="sol__chapter_shell" class="sol__chapter_shell">
    <div class="sol__chapter_shell_article">
      <div class="sol__chapter_content">
        <slot />
      </div>

      <mantle data-shape="sol__chapter_pager" class="sol__chapter_pager">
        <ul class="sol__chapter_pager_list">
          <li class="sol__chapter_pager_item sol__chapter_pager_item_previous">
            {
              previous_chapter_link ? (
                <a
                  class="sol__chapter_pager_link"
                  href={previous_chapter_link.href}
                  hx-get={previous_chapter_link.hx_get}
                  hx-target={previous_chapter_link.hx_target}
                  hx-select={previous_chapter_link.hx_select}
                  hx-swap={previous_chapter_link.hx_swap}
                >
                  Previous chapter
                </a>
              ) : (
                <span class="sol__chapter_pager_placeholder">
                  Previous chapter
                </span>
              )
            }
          </li>
          <li class="sol__chapter_pager_item sol__chapter_pager_item_next">
            {
              next_chapter_link ? (
                <a
                  class="sol__chapter_pager_link"
                  href={next_chapter_link.href}
                  hx-get={next_chapter_link.hx_get}
                  hx-target={next_chapter_link.hx_target}
                  hx-select={next_chapter_link.hx_select}
                  hx-swap={next_chapter_link.hx_swap}
                >
                  Next chapter
                </a>
              ) : (
                <span class="sol__chapter_pager_placeholder">Next chapter</span>
              )
            }
          </li>
        </ul>
      </mantle>
    </div>
  </rubedo>
</IndexLayout>
