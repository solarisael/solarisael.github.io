{
  "name": "solarisael",
  "version": "0.1.0",
  "description": "sun + aris + aleph + el — the being placed within the divine architecture",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:start": "bun scripts/dev_server.js start",
    "dev:wait": "bun scripts/dev_server.js wait",
    "dev:stop": "bun scripts/dev_server.js stop",
    "dev:status": "bun scripts/dev_server.js status",
    "dev:check": "bun scripts/dev_server.js check",
    "build": "astro build && bun scripts/finalize_publication.js",
    "code:quality": "bun scripts/code_quality_audit.js",
    "content:sync": "bun scripts/sync_public_content.js",
    "content:check": "bun scripts/sync_public_content.js --check",
    "preview": "astro preview",
    "test": "bun test",
    "format:check": "prettier --check \"src/**/*.{astro,css,js,json}\" \"public/js/**/*.js\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.js\" \".github/**/*.{yml,yaml}\" \"astro.config.mjs\" \"package.json\"",
    "new:post": "bun scripts/new_post.js",
    "css:size:audit": "bun scripts/css_size_audit.js check --scope=priority-a",
    "rubedo:scenes:check": "bun scripts/rubedo_scene_identity_audit.js check",
    "css:ornaments:check": "bun scripts/css_ornaments_audit.js check",
    "css:bg-stack:check": "bun scripts/css_background_stack_audit.js check",
    "css:hard-gates:check": "bun run css:ornaments:check && bun run css:bg-stack:check",
    "laws:check": "bun scripts/check_laws.js",
    "site:check": "bun scripts/check_publication.js"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@chenglou/pretext": "^0.0.8",
    "@tanstack/virtual-core": "^3.17.11",
    "@vgpu/wgsl": "^0.4.1",
    "@vgpu/wgsl-std": "^0.4.1",
    "astro": "^7.3.2",
    "htmx.org": "^2.0.10",
    "idiomorph": "^0.7.4",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.1",
    "rehype-raw": "^7.0.0",
    "scripts-of-folly": "github:solarisael/scripts-of-folly#5488d3b05d77234f17118ccd281d3eca4b56dcea",
    "three": "^0.185.1",
    "vgpu": "^0.4.1"
  },
  "devDependencies": {
    "@astrojs/compiler": "2.13.1",
    "@happy-dom/global-registrator": "^20.14.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "happy-dom": "20.14.5",
    "saxes": "6.0.0",
    "typescript": "5.9.3",
    "vite": "^8.0.16"
  }
}
